<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BudgetWise.Views.TransactionFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20,24,20,24"
                Spacing="20"
                MaximumWidthRequest="540"
                HorizontalOptions="Fill">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource AppPrimary}" Stroke="{StaticResource AppBorderBrush}" StrokeThickness="3"
                            StrokeShape="Rectangle" WidthRequest="46" HeightRequest="46">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked" />
                        </Border.GestureRecognizers>
                        <Path Data="M19,12 L5,12 M5,12 L12,5 M5,12 L12,19"
                              Stroke="{StaticResource AppOnPrimaryBrush}" StrokeThickness="2.5"
                              StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="20" HeightRequest="20"
                              HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label
                            Text="New transaction"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AppText}" />
                        <Label
                            Text="Keep your finances organized"
                            FontSize="13"
                            TextColor="{StaticResource AppMuted}" />
                    </VerticalStackLayout>
                </Grid>

                <Border
                    BackgroundColor="{StaticResource AppCardAlt}"
                    Stroke="{StaticResource AppBorderBrush}"
                    StrokeThickness="3"
                    StrokeShape="Rectangle"
                    Padding="20">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="TRANSACTION TYPE" FontAttributes="Bold" TextColor="{StaticResource AppText}" />
                            <Picker
                                x:Name="TypePicker"
                                Title="Choose type"
                                TextColor="{StaticResource AppText}"
                                TitleColor="{StaticResource AppMuted}"
                                SelectedIndexChanged="OnTypeChanged" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="AMOUNT (RON)" FontAttributes="Bold" TextColor="{StaticResource AppText}" />
                            <Border
                                BackgroundColor="{StaticResource AppBackground}"
                                Stroke="{StaticResource AppBorderBrush}"
                                StrokeThickness="2"
                                StrokeShape="Rectangle"
                                Padding="12,3">
                                <Entry
                                    x:Name="AmountEntry"
                                    Placeholder="0.00"
                                    Keyboard="Numeric"
                                    FontSize="22"
                                    TextColor="{StaticResource AppText}"
                                    PlaceholderColor="{StaticResource AppSubtle}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="CATEGORY" FontAttributes="Bold" TextColor="{StaticResource AppText}" />
                            <Picker
                                x:Name="CategoryPicker"
                                Title="Select category"
                                ItemDisplayBinding="{Binding Name}"
                                TextColor="{StaticResource AppText}"
                                TitleColor="{StaticResource AppMuted}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="DATE" FontAttributes="Bold" TextColor="{StaticResource AppText}" />
                            <DatePicker
                                x:Name="TransactionDatePicker"
                                Format="dd MMM yyyy"
                                TextColor="{StaticResource AppText}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="DESCRIPTION" FontAttributes="Bold" TextColor="{StaticResource AppText}" />
                            <Border
                                BackgroundColor="{StaticResource AppBackground}"
                                Stroke="{StaticResource AppBorderBrush}"
                                StrokeThickness="2"
                                StrokeShape="Rectangle"
                                Padding="12">
                                <Editor
                                    x:Name="DescriptionEditor"
                                    Placeholder="What was this transaction for?"
                                    PlaceholderColor="{StaticResource AppSubtle}"
                                    TextColor="{StaticResource AppText}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="80" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border
            Grid.Row="1"
            BackgroundColor="{StaticResource AppBackground}"
            Stroke="{StaticResource AppBorderBrush}"
            StrokeThickness="3"
            Padding="20,12,20,20">
            <Button
                x:Name="SaveButton"
                Text="Save transaction"
                BackgroundColor="{StaticResource AppPrimary}"
                TextColor="{StaticResource AppOnPrimary}"
                BorderColor="{StaticResource AppBorder}"
                BorderWidth="3"
                FontAttributes="Bold"
                FontSize="15"
                CornerRadius="0"
                HeightRequest="54"
                Clicked="OnSaveClicked" />
        </Border>
    </Grid>
</ContentPage>
