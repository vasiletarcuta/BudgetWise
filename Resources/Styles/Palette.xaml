<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BudgetWise palette. Every page, chart and the code-behind read these names (see Services/Palette.cs). -->

    <Color x:Key="AppBackground">#DCE6D4</Color>
    <Color x:Key="AppCard">#F6FAF2</Color>
    <Color x:Key="AppCardAlt">#ECF3E6</Color>
    <Color x:Key="AppBorder">#2C4A3A</Color>
    <Color x:Key="AppTrack">#C8D8BE</Color>
    <Color x:Key="AppGrid">#C9D8C1</Color>
    <Color x:Key="AppText">#1C2B22</Color>
    <Color x:Key="AppMuted">#4D6256</Color>
    <Color x:Key="AppSubtle">#7F9487</Color>
    <Color x:Key="AppPrimary">#B7E4A0</Color>
    <Color x:Key="AppPrimaryText">#29704A</Color>
    <Color x:Key="AppOnPrimary">#14281E</Color>
    <Color x:Key="AppIncome">#8FE0C0</Color>
    <Color x:Key="AppIncomeText">#177352</Color>
    <Color x:Key="AppButter">#F2DC9B</Color>
    <Color x:Key="AppExpense">#F29C92</Color>
    <Color x:Key="AppExpenseText">#B5453A</Color>
    <Color x:Key="AppHeatEmpty">#D8E5D0</Color>
    <Color x:Key="AppChart1">#B7E4A0</Color>
    <Color x:Key="AppChart2">#F2DC9B</Color>
    <Color x:Key="AppChart3">#F29C92</Color>
    <Color x:Key="AppChart4">#8FE0C0</Color>
    <Color x:Key="AppChart5">#9CC8E8</Color>
    <Color x:Key="AppChart6">#C7B8F0</Color>
    <Color x:Key="AppChart7">#F5B982</Color>
    <Color x:Key="AppChart8">#E9A6C0</Color>
    <Color x:Key="AppWrappedIntroBg">#1F3A2E</Color>
    <Color x:Key="AppWrappedIntroAccent">#B7E4A0</Color>
    <Color x:Key="AppWrappedText">#F5F8F2</Color>
    <Color x:Key="AppWrappedMuted">#B9CCBF</Color>
    <Color x:Key="AppWrappedChip">#14281E</Color>
    <Color x:Key="AppWrappedTrack">#3F6A56</Color>
    <Color x:Key="AppWrappedTopBg">#3B3A5C</Color>
    <Color x:Key="AppWrappedTopAccent">#C7B8F0</Color>
    <Color x:Key="AppWrappedDayBg">#5A3A3C</Color>
    <Color x:Key="AppWrappedDayAccent">#F6B1A8</Color>
    <Color x:Key="AppWrappedSaveBg">#1F5A4F</Color>
    <Color x:Key="AppWrappedSaveAccent">#9DEBD0</Color>
    <Color x:Key="AppWrappedCompareBg">#54522E</Color>
    <Color x:Key="AppWrappedCompareAccent">#F2DC9B</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppCard}" />
    <SolidColorBrush x:Key="AppCardAltBrush" Color="{StaticResource AppCardAlt}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
    <SolidColorBrush x:Key="AppTrackBrush" Color="{StaticResource AppTrack}" />
    <SolidColorBrush x:Key="AppGridBrush" Color="{StaticResource AppGrid}" />
    <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppText}" />
    <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource AppMuted}" />
    <SolidColorBrush x:Key="AppSubtleBrush" Color="{StaticResource AppSubtle}" />
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="{StaticResource AppPrimary}" />
    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="{StaticResource AppPrimaryText}" />
    <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="{StaticResource AppOnPrimary}" />
    <SolidColorBrush x:Key="AppIncomeBrush" Color="{StaticResource AppIncome}" />
    <SolidColorBrush x:Key="AppIncomeTextBrush" Color="{StaticResource AppIncomeText}" />
    <SolidColorBrush x:Key="AppButterBrush" Color="{StaticResource AppButter}" />
    <SolidColorBrush x:Key="AppExpenseBrush" Color="{StaticResource AppExpense}" />
    <SolidColorBrush x:Key="AppExpenseTextBrush" Color="{StaticResource AppExpenseText}" />
    <SolidColorBrush x:Key="AppHeatEmptyBrush" Color="{StaticResource AppHeatEmpty}" />
    <SolidColorBrush x:Key="AppChart1Brush" Color="{StaticResource AppChart1}" />
    <SolidColorBrush x:Key="AppChart2Brush" Color="{StaticResource AppChart2}" />
    <SolidColorBrush x:Key="AppChart3Brush" Color="{StaticResource AppChart3}" />
    <SolidColorBrush x:Key="AppChart4Brush" Color="{StaticResource AppChart4}" />
    <SolidColorBrush x:Key="AppChart5Brush" Color="{StaticResource AppChart5}" />
    <SolidColorBrush x:Key="AppChart6Brush" Color="{StaticResource AppChart6}" />
    <SolidColorBrush x:Key="AppChart7Brush" Color="{StaticResource AppChart7}" />
    <SolidColorBrush x:Key="AppChart8Brush" Color="{StaticResource AppChart8}" />
    <SolidColorBrush x:Key="AppWrappedIntroBgBrush" Color="{StaticResource AppWrappedIntroBg}" />
    <SolidColorBrush x:Key="AppWrappedIntroAccentBrush" Color="{StaticResource AppWrappedIntroAccent}" />
    <SolidColorBrush x:Key="AppWrappedTextBrush" Color="{StaticResource AppWrappedText}" />
    <SolidColorBrush x:Key="AppWrappedMutedBrush" Color="{StaticResource AppWrappedMuted}" />
    <SolidColorBrush x:Key="AppWrappedChipBrush" Color="{StaticResource AppWrappedChip}" />
    <SolidColorBrush x:Key="AppWrappedTrackBrush" Color="{StaticResource AppWrappedTrack}" />
    <SolidColorBrush x:Key="AppWrappedTopBgBrush" Color="{StaticResource AppWrappedTopBg}" />
    <SolidColorBrush x:Key="AppWrappedTopAccentBrush" Color="{StaticResource AppWrappedTopAccent}" />
    <SolidColorBrush x:Key="AppWrappedDayBgBrush" Color="{StaticResource AppWrappedDayBg}" />
    <SolidColorBrush x:Key="AppWrappedDayAccentBrush" Color="{StaticResource AppWrappedDayAccent}" />
    <SolidColorBrush x:Key="AppWrappedSaveBgBrush" Color="{StaticResource AppWrappedSaveBg}" />
    <SolidColorBrush x:Key="AppWrappedSaveAccentBrush" Color="{StaticResource AppWrappedSaveAccent}" />
    <SolidColorBrush x:Key="AppWrappedCompareBgBrush" Color="{StaticResource AppWrappedCompareBg}" />
    <SolidColorBrush x:Key="AppWrappedCompareAccentBrush" Color="{StaticResource AppWrappedCompareAccent}" />

</ResourceDictionary>
